{
    "default_locale": "fa",
    "name": "__MSG_extension_name__",
    "version": "4.0.1",
    "short_name": "__MSG_extension_short_name__",
    "background": {
        "scripts": [
            "js/background.js"
        ]
    },
    "author": "alisaffaridev@gmail.com",
    "homepage_url": "https://ai-rtl.ir",
    "permissions": [
        "storage",
        "tabs",
        "scripting"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "description": "__MSG_extension_description__",
    "manifest_version": 3,
    "icons": {
        "16": "images/logo/icon-16.png",
        "32": "images/logo/icon-32.png",
        "48": "images/logo/icon-48.png",
        "128": "images/logo/icon-128.png"
    },
    "content_scripts": [
        {
            "css": [
                "style.css"
            ],
            "js": [
                "js/inject-fonts.js",
                "js/myJquery-3.7.1.js",
                "js/content.js"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "images/*",
                "fonts/*"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ],
    "action": {
        "default_popup": "index.html",
        "default_title": "__MSG_extension_action_title__",
        "default_icon": {
            "16": "images/logo/icon-16.png",
            "32": "images/logo/icon-32.png",
            "48": "images/logo/icon-48.png",
            "128": "images/logo/icon-128.png"
        }
    },
    "options_ui": {
        "page": "options.html",
        "open_in_tab": true
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "ai-rtl@ai-rtl.ir",
            "strict_min_version": "140.0",
            "data_collection_permissions": {
                "required": [
                    "none"
                ]
            }
        },
        "gecko_android": {
            "strict_min_version": "142.0"
        }
    }
}