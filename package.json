{
  "name": "react-chrome-ext",
  "version": "4.0.9",
  "private": true,
  "dependencies": {
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@mdi/js": "^7.4.47",
    "@mui/icons-material": "^5.15.18",
    "@mui/material": "^5.15.18",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/chrome": "^0.0.268",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.18.11",
    "@types/react": "^18.0.27",
    "@types/react-dom": "^18.0.10",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.7.3",
    "html-webpack-plugin": "^5.5.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "stylis": "^4.3.6",
    "stylis-plugin-rtl": "^2.1.1",
    "transform-remove-console": "^0.0.1-security",
    "typescript": "^4.9.4",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "build:chrome": "cross-env NODE_ENV=production webpack --config webpack.config.chrome.js",
    "build:chrome:dev": "cross-env NODE_ENV=development webpack --config webpack.config.chrome.js",
    "build:chrome:release": "node scripts/build-chrome.js",
    "build:firefox": "node scripts/build-firefox.js",
    "build-for-amo": "npm run build:firefox",
    "zip:source": "node scripts/zip-source.js",
    "firefox": "node scripts/run-firefox.js",
    "firefox:lint": "web-ext lint --source-dir dist-firefox",
    "firefox:dev": "cross-env NODE_ENV=development webpack --watch --config webpack.config.firefox.js",
    "chrome:dev": "cross-env NODE_ENV=development webpack --watch --config webpack.config.chrome.js",
    "chrome:watch": "cross-env NODE_ENV=development webpack --watch --config webpack.config.chrome.js",
    "watch": "cross-env NODE_ENV=development webpack --watch --config webpack.config.chrome.js",
    "version:bump": "node scripts/version-bump.js"
  },
  "cursor": {
    "commitMessage": {
      "maxLength": 50,
      "language": "english",
      "format": "conventional",
      "examples": [
        "feat: add blog management page",
        "fix: resolve date display issue",
        "refactor: improve component code",
        "style: update button colors",
        "docs: update documentation"
      ]
    }
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@types/stylis": "^4.2.7",
    "archiver": "^7.0.1",
    "babel-loader": "^9.1.3",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "baseline-browser-mapping": "^2.11.9",
    "cross-env": "^10.0.0",
    "style-loader": "^3.3.4",
    "terser-webpack-plugin": "^5.3.6",
    "ts-loader": "^9.4.2",
    "web-ext": "^10.5.0",
    "webpack": "^5.75.0",
    "webpack-cli": "^5.1.4"
  }
}